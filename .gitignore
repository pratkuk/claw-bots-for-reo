# ─── Environment ──────────────────────────────────────────
# NEVER commit .env — it holds API keys and secrets.
.env
.env.local
.env.*.local

# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ─── Node (for workspace/projects/hello-test Vite app) ────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# ─── Editors ──────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ─── Runtime state (never commit — holds tokens + PII) ────
workspace/.slack_installations/
workspace/.slack_oauth_state/
workspace/.claw_configs/
workspace/spike_live.log
workspace/spike_live.stdout.log
workspace/last-failed-digest.md
